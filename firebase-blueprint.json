{
  "entities": {
    "Event": {
      "title": "Event",
      "description": "A corporate event managed within the Event Attendance System.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "eventDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "endTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "lateCutoffMinutes": {
          "type": "integer"
        },
        "venue": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "capacity": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["upcoming", "active", "completed", "archived"]
        },
        "sharedQrEnabled": {
          "type": "boolean"
        },
        "registrationOpen": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "eventDate",
        "startTime",
        "endTime",
        "lateCutoffMinutes",
        "venue",
        "capacity",
        "status",
        "sharedQrEnabled",
        "registrationOpen",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "QrToken": {
      "title": "QrToken",
      "description": "Shared event QR verification token document keyed by the secret token string.",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 12,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "active": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "token",
        "eventId",
        "active",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "StaffRole": {
      "title": "StaffRole",
      "description": "Role assignment for authorized company admins and event staff keyed by verified email.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["admin", "staff"]
        },
        "active": {
          "type": "boolean"
        },
        "addedByEmail": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email",
        "displayName",
        "role",
        "active",
        "addedByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "Participant": {
      "title": "Participant",
      "description": "Registered event participant with unique QR identifier and atomic attendance state.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "mobile": {
          "type": "string",
          "minLength": 6,
          "maxLength": 25
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "position": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "qrSecret": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "registeredByUid": {
          "type": "string",
          "maxLength": 128
        },
        "registrationSource": {
          "type": "string",
          "enum": ["online", "admin_manual", "bulk_import"]
        },
        "registrationDate": {
          "type": "string",
          "format": "date-time"
        },
        "attendanceStatus": {
          "type": "string",
          "enum": ["pending", "present", "late", "absent"]
        },
        "checkInAt": {
          "type": "string",
          "format": "date-time"
        },
        "checkInMethod": {
          "type": "string",
          "enum": ["individual_qr", "shared_qr", "manual_staff", "admin_override", "none"]
        },
        "checkedInByUid": {
          "type": "string",
          "maxLength": 128
        },
        "checkedInByEmail": {
          "type": "string",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "eventId",
        "fullName",
        "email",
        "mobile",
        "company",
        "position",
        "qrSecret",
        "registeredByUid",
        "registrationSource",
        "registrationDate",
        "attendanceStatus",
        "checkInMethod",
        "checkedInByUid",
        "checkedInByEmail",
        "notes",
        "updatedAt"
      ]
    },
    "AttendanceLog": {
      "title": "AttendanceLog",
      "description": "Single-use atomic check-in lock document keyed by participantId to prevent duplicate check-ins.",
      "type": "object",
      "properties": {
        "participantId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["present", "late"]
        },
        "method": {
          "type": "string",
          "enum": ["individual_qr", "shared_qr", "manual_staff", "admin_override"]
        },
        "qrTokenUsed": {
          "type": "string",
          "maxLength": 64
        },
        "checkedInByUid": {
          "type": "string",
          "maxLength": 128
        },
        "checkedInByEmail": {
          "type": "string",
          "maxLength": 120
        },
        "checkedInAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "participantId",
        "eventId",
        "participantName",
        "company",
        "status",
        "method",
        "qrTokenUsed",
        "checkedInByUid",
        "checkedInByEmail",
        "checkedInAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only audit trail entry recording attendance events, corrections, and admin operations.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "enum": [
            "event_created",
            "event_updated",
            "shared_qr_toggled",
            "participant_registered",
            "participant_updated",
            "participant_deleted",
            "checkin_individual_qr",
            "checkin_shared_qr",
            "checkin_manual_staff",
            "attendance_corrected",
            "staff_role_updated",
            "report_exported"
          ]
        },
        "actorUid": {
          "type": "string",
          "maxLength": 128
        },
        "actorEmail": {
          "type": "string",
          "maxLength": 120
        },
        "actorRole": {
          "type": "string",
          "enum": ["admin", "staff", "participant"]
        },
        "targetId": {
          "type": "string",
          "maxLength": 128
        },
        "targetLabel": {
          "type": "string",
          "maxLength": 160
        },
        "details": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "eventId",
        "action",
        "actorUid",
        "actorEmail",
        "actorRole",
        "targetId",
        "targetLabel",
        "details",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Corporate events collection containing schedule, venue, capacity, and registration settings."
    },
    "/events/{eventId}/qr_tokens/{token}": {
      "schema": { "$ref": "#/entities/QrToken" },
      "description": "Active Shared Event QR verification tokens scoped to an event."
    },
    "/events/{eventId}/participants/{participantId}": {
      "schema": { "$ref": "#/entities/Participant" },
      "description": "Registered participants for an event including unique QR secrets and attendance state."
    },
    "/events/{eventId}/attendance_logs/{participantId}": {
      "schema": { "$ref": "#/entities/AttendanceLog" },
      "description": "Single-use atomic check-in receipt keyed by participantId."
    },
    "/events/{eventId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable append-only audit log for event attendance and administrative actions."
    },
    "/staff_roles/{email}": {
      "schema": { "$ref": "#/entities/StaffRole" },
      "description": "Role-based access control directory mapping verified emails to admin or staff roles."
    }
  }
}
